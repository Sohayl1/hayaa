# ====================================================
# إعدادات البيئة الإنتاجية لمنصة حياه (Environment Variables)
# ====================================================

# منفذ السيرفر
PORT=5000
NODE_ENV=production

# قاعدة البيانات (SQLite للتطوير المحلي، أو PostgreSQL للإنتاج السحابي)
# مثال PostgreSQL: postgres://user:password@hostname:5432/hayaadb
DATABASE_URL=
DB_STORAGE=database.sqlite

# المفتاح السري لتشفير جلسات الدخول والـ JWT
JWT_SECRET=your_super_strong_production_secret_key_here

# رابط المنصة للعموم (HTTPS)
CLIENT_URL=https://hayaa-health.onrender.com
SERVER_BASE_URL=https://hayaa-health.onrender.com

# إعدادات إرسال الإيميلات ورموز التحقق (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=منصة حياه للرعاية الصحية <no-reply@hayaa.com>

# إعدادات بوابات الدفع الإلكتروني (Paymob مصر)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# إعدادات الدفع الدولي (Stripe)
STRIPE_SECRET_KEY=sk_live_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
